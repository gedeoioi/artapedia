APP_NAME=ArtaPedia
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Gateway WhatsApp (notifikasi transaksi) ---
# URL dan token sebenarnya diisi dari panel admin (Notifikasi WA), bukan di sini.
# Baris ini hanya nilai awal / default; kredensial tidak perlu masuk .env.
WA_GATEWAY_URL=https://api.deoioi.my.id
WA_GATEWAY_TOKEN_HEADER=X-API-Key
WA_GATEWAY_FORMAT=json
WA_GATEWAY_TIMEOUT=20
WA_GATEWAY_TRIES=3
# Template payload JSON. {{phone}} dan {{message}} diisi otomatis dan di-escape.
WA_GATEWAY_PAYLOAD='{"to": "{{phone}}", "body": "{{message}}"}'

# Jendela idempotensi order (detik). Request checkout identik dalam rentang ini
# dianggap satu order. Jangan diperkecil di bawah 60 detik.
ORDER_IDEMPOTENCY_WINDOW=120
